# Maintainer: AI Reader Team <dev@ai-reader.io>
pkgname=ai-reader
pkgver=3.0.0
pkgrel=1
pkgdesc="Headless Core Computation and Document Parsing Engine CLI"
arch=('x86_64')
url="https://github.com/ai-reader/ai-reader"
license=('MIT')
depends=('python')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    install -d "${pkgdir}/usr/lib/ai-reader"
    install -d "${pkgdir}/usr/bin"

    install -m755 linux/ai_reader_app.py "${pkgdir}/usr/lib/ai-reader/ai_reader"
    cp -r backend "${pkgdir}/usr/lib/ai-reader/"
    ln -sf /usr/lib/ai-reader/ai_reader "${pkgdir}/usr/bin/ai_reader"
}
